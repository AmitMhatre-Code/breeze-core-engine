# Copy to `.env` at repo root (gitignored). Backend loads this via main.py dotenv.

# --- Option A: local Next.js → API on AWS (static IP for live ICICI) ---
# Set only on your machine for `next dev`. Do NOT put this in production EC2 secrets.
# BACKEND_UPSTREAM_URL=https://your-public-api-host

# --- Option D: mock broker (no live ICICI / no static IP on laptop) ---
# ICICI_BROKER_MODE=mock
# Optional: treat broker cookie as present when JWT exists (no POST needed):
# ICICI_MOCK_SYNTHETIC_BROKER_TOKEN=1
# ICICI_MOCK_BROKER_COOKIE_VALUE=mock
# Frontend banner (set when running `next dev` / local build; omit in production image):
# NEXT_PUBLIC_ICICI_BROKER_MODE=mock
# Google sign-in in mock: after OAuth, POST /dev/mock-broker-cookie (proxied by Next) with credentials,
# or enable ICICI_MOCK_SYNTHETIC_BROKER_TOKEN=1. Direct app-password login skips ICICI when mock.

# --- Option E: simulate market-hours vs after-market-hours locally (just run ./dev.sh) ---
# MOCK_MARKET_MODE alone is enough -- dev.sh derives ICICI_BROKER_MODE=mock and
# MARKET_HOURS_OVERRIDE from it, and auto-starts a local Redis if needed (LIVE mode
# needs one: the backend and chain_builder worker are separate processes that only
# share subscription/tick state through Redis).
#   MOCK_MARKET_MODE=LIVE        -> chain quotes come from MockBreezeSdk's simulated
#                                    WebSocket ticks (random-walk LTP/high/low/volume)
#   MOCK_MARKET_MODE=OFF_MARKET  -> chain quotes come from the real bhavcopy/reference-data
#                                    pipeline (needs real internet to nseindia.com/bseindia.com;
#                                    not mocked, since bhavcopy is public data anyway)
MOCK_MARKET_MODE=LIVE

# --- Google OAuth (localhost) ---
# Register redirect URI in Google Cloud, e.g. http://localhost:3000/auth/google/callback
# GOOGLE_OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# --- ICICI browser login ---
# ICICI return URL is configured in ICICI developer portal; must match your deployed host
# unless you use hosts-file mapping (see project dev docs).

# Contact Sales mailto (frontend; baked at Next build time)
# SALES_EMAIL=sales@breeze-ui.com

# --- Option B: local backend + egress via AWS (proxy) ---
# export HTTPS_PROXY=http://127.0.0.1:8888
# export HTTP_PROXY=http://127.0.0.1:8888

# --- Option F: simulate valid vs invalid deployment license locally (no real portal needed) ---
# Forces the deployment license status without a portal/heartbeat round trip, so you can
# test read-only-mode enforcement (403s on order/book/hedge/strategy-builder mutation routes).
# One of: active | expired | revoked | unlicensed | pending_activation | trial_denied
#   active      -> valid license, trading allowed
#   revoked / unlicensed / pending_activation / trial_denied -> invalid license, read-only mode
#   expired     -> invalid-ish but trading still allowed (grace period), per design
# Leave unset for normal portal-driven behavior. Never set in production.
# LICENSE_STATUS_OVERRIDE=revoked
