# Environment Configuration Template
# Copy this file to .env and fill in actual values for deployment

# Application Settings
DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./data/db.sqlite3

# JWT & Authentication — set ONE of these (same value for login and credential encryption)
# Use the same value when running the migration script and the app.
JWT_SECRET=oEiUsKGoxeosDs61TUvZ9mEKjlamqMKEwqeWgaehPP8
# ENCRYPTION_KEY=your-secret-key-at-least-32-characters-long

# Google OAuth (required for registration, correction, delete)
# GOOGLE_CLIENT_ID=700736216211-a7g601u7sf92tpdd2qjas5u7i16ri5if.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=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
GOOGLE_CLIENT_ID=680592484146-odh9lqpk4t3e89295mpfa6uo119flcbo.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Set COOKIE_SECURE=true in production (HTTPS) for ICICI broker token cookie
COOKIE_SECURE=false
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cache Configuration
CACHE_TTL_SECONDS=300
CACHE_MAX_TTL_SECONDS=1800
MASTER_DATA_CACHE_TTL=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Audit
AUDIT_LOG_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_CHECK_INTERVAL_HOURS=24

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_PER_USER=true

# CORS
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization

# Server
PORT=8000
HOST=0.0.0.0
WORKERS=4

# Testing
TEST_MODE=false
ICICI_SANDBOX_MODE=true

E2E_RATE_LIMIT_BYPASS_SECRET=abcdefghijklmnopqrstuvwxyz0123456789

PUBLIC_FRONTEND_ORIGIN=http://127.0.0.1:3000
GOOGLE_OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:3000
ICICI_BREEZE_INSECURE_SSL=1