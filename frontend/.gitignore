Icon?
._*

# npm pack output
*.tgz

# Parcel, Snowpack, Vite
/dist

# Svelte
*.svelte-kit

# Storybook
.out/
.storybook-static

# misc build/dev artifacts
/.turbo
npm-debug.log*
lerna-debug.log*

# lock files (yarn/pnpm if used; npm lockfile is committed for Docker/CI reproducibility)
yarn.lock
pnpm-lock.yaml

